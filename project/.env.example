# Copy this file to .env.local for the web app and to apps/mobile/.env for Expo.
# Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only backend package. Keep these out of NEXT_PUBLIC_* and client bundles.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SECRET_KEY=your-secret-key

# Expo public configuration (put in apps/mobile/.env).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional metadata used by the admin promotion command.
PRECOPERTO_ADMIN_EMAIL=admin@example.com
